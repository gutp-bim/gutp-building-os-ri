        "issuedAt": "2026-01-01T00:00:00"
      },
      "expectedError": "invalid_utc"
    },
    {
      "name": "frame timestamp outside acquisition",
      "acquisitionPatch": {
        "endedAt": "2026-01-01T00:00:04Z"
      },
      "expectedError": "timestamp_outside_acquisition"
