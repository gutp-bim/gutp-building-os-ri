        "sim_context_generation"
      ],
      "expected": {
        "quality": "stable_unfenced",
        "runStatus": "invalid",
        "runReason": "not_yet_valid",
        "runTimeEligible": false,
        "strictStepEligible": false
      }
    },
    {
      "name": "unknown profile is not guessed",
      "profile": "unknown-producer",
      "expectedError": "unknown_profile"
    },
    {
      "name": "unrelated clock cannot be attached to a point",
      "attributes": {
        "sim_clock_id": "https://example.com/another-clock"
      },
      "expectedError": "clock_scope_mismatch"
    },
    {
      "name": "unknown point is not clock telemetry",
      "framePatch": {
        "point_id": "BPT-0001"
      },
      "expectedError": "point_missing"
    },
    {
      "name": "durable commit alone is not application",
      "frame": "telemetry-with-run.json",
      "context": "run-context.json",
      "receiverPatch": {
        "appliedAt": null
      },
      "attributes": {
        "sim_run_status": "unverified",
        "sim_run_reason": "context_not_applied"
      },
      "omitAttributes": [
        "sim_run_id",
        "sim_context_generation"
      ],
      "expected": {
        "quality": "stable_unfenced",
        "runStatus": "unverified",
        "runReason": "context_not_applied",
        "runTimeEligible": false,
        "strictStepEligible": false
      }
    },
    {
      "name": "context applied after acquisition started",
      "frame": "telemetry-with-run.json",
      "context": "run-context.json",
      "receiverPatch": {
        "appliedAt": "2026-01-01T00:00:05Z"
      },
      "attributes": {
        "sim_run_status": "invalid",
        "sim_run_reason": "context_not_active_at_start"
      },
      "omitAttributes": [
        "sim_run_id",
        "sim_context_generation"
      ],
      "expected": {
        "quality": "stable_unfenced",
        "runStatus": "invalid",
        "runReason": "context_not_active_at_start",
        "runTimeEligible": false,
        "strictStepEligible": false
      }
    }
  ]
