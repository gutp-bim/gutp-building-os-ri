    },
    {
      "name": "incomplete chunk coverage",
      "acquisitionPatch": {
        "clockSamples": [
          "120.5",
          "120.5"
        ]
      },
      "expectedError": "incomplete_clock_boundaries"
    },
    {
      "name": "missing stable numeric time",
      "omitAttributes": [
        "sim_time_s"
      ],
      "expectedError": "stable_time_mismatch"
    },
    {
      "name": "changed cannot carry time",
      "attributes": {
        "sim_time_quality": "changed"
      },
      "acquisitionPatch": {
        "clockSamples": [
          "120.5",
          "180",
          "180"
        ]
      },
      "expectedError": "unstable_time_present"
    },
    {
      "name": "reject NaN sim time",
      "attributes": {
        "sim_time_s": "NaN"
      },
      "expectedError": "invalid_sim_time"
    },
    {
      "name": "reject infinity sim time",
      "attributes": {
        "sim_time_s": "Infinity"
      },
      "expectedError": "invalid_sim_time"
    },
    {
      "name": "reject negative sim time",
      "attributes": {
        "sim_time_s": "-1"
      },
      "expectedError": "invalid_sim_time"
    },
    {
      "name": "reject whitespace sim time",
      "attributes": {
        "sim_time_s": " 120.5"
      },
      "expectedError": "invalid_sim_time"
    },
    {
      "name": "reject leading zero sim time",
      "attributes": {
        "sim_time_s": "0120.5"
      },
      "expectedError": "invalid_sim_time"
    },
    {
      "name": "attributes must remain strings",
      "attributes": {
        "sim_time_s": 120.5
      },
      "expectedError": "attributes_must_be_strings"
    },
    {
      "name": "scientific numeric notation is finite seconds",
      "attributes": {
        "sim_time_s": "1.205e2"
      },
      "expected": {
        "quality": "stable_unfenced",
        "runStatus": "absent",
        "runReason": null,
        "runTimeEligible": false,
        "strictStepEligible": false
      }
    },
    {
      "name": "reject boolean generation",
      "frame": "telemetry-with-run.json",
      "context": "run-context.json",
      "contextPatch": {
        "generation": true
      },
      "expectedError": "invalid_generation"
    },
    {
      "name": "reject zero generation",
      "frame": "telemetry-with-run.json",
      "context": "run-context.json",
      "contextPatch": {
        "generation": 0
      },
      "expectedError": "invalid_generation"
    },
    {
      "name": "reject negative generation",
      "frame": "telemetry-with-run.json",
      "context": "run-context.json",
      "contextPatch": {
        "generation": -1
      },
      "expectedError": "invalid_generation"
    },
    {
      "name": "reject floating generation",
      "frame": "telemetry-with-run.json",
      "context": "run-context.json",
      "contextPatch": {
        "generation": 1.0
      },
      "expectedError": "invalid_generation"
    },
    {
      "name": "reject unsafe JSON integer generation",
      "frame": "telemetry-with-run.json",
      "context": "run-context.json",
      "contextPatch": {
        "generation": 9007199254740992
      },
      "expectedError": "invalid_generation"
    },
    {
      "name": "context cannot carry acquisition mode",
      "frame": "telemetry-with-run.json",
      "context": "run-context.json",
      "contextPatch": {
        "consistencyMode": "bracket-only"
      },
      "expectedError": "invalid_context_fields"
    },
    {
      "name": "context cannot self-authenticate",
      "frame": "telemetry-with-run.json",
      "context": "run-context.json",
      "contextPatch": {
        "authenticated": true
      },
      "expectedError": "invalid_context_fields"
    },
    {
      "name": "empty run identity",
      "frame": "telemetry-with-run.json",
      "context": "run-context.json",
      "contextPatch": {
        "runId": ""
      },
      "expectedError": "invalid_context_identity"
    },
    {
      "name": "empty context interval",
      "frame": "telemetry-with-run.json",
      "context": "run-context.json",
