    {
      "name": "frame must match selected historical snapshot",
      "attributes": {
        "sim_config_revision": "\"sha256:other\""
      },
      "expectedError": "frame_revision_mismatch"
    },
    {
      "name": "new producer must use canonical revision",
      "attributes": {
        "sim_clock_revision": "\"sha256:ca3125a6b31a0f1a98297be621138452eeebdda7cb5126710f3284b40b78f298\""
      },
      "omitAttributes": [
        "sim_config_revision"
      ],
      "expectedError": "canonical_revision_required"
    },
    {
      "name": "valid run must match observation run ID",
      "frame": "telemetry-with-run.json",
      "context": "run-context.json",
      "attributes": {
        "sim_run_id": "invented"
      },
      "expectedError": "run_identity_mismatch"
    },
    {
      "name": "generation attribute is exact decimal representation",
      "frame": "telemetry-with-run.json",
      "context": "run-context.json",
      "attributes": {
        "sim_context_generation": "01"
      },
      "expectedError": "run_identity_mismatch"
    },
    {
      "name": "reason cannot contradict derived run state",
      "attributes": {
        "sim_run_reason": "expired"
      },
      "expectedError": "run_reason_mismatch"
    },
    {
      "name": "fractional context boundary is not rounded down",
      "frame": "telemetry-with-run.json",
      "context": "run-context.json",
