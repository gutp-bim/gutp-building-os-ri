  "cards": [
    {
      "dot": "emerald",
      "title": "主経路",
      "items": [
        "ゲートウェイは point_id だけを送り、ツイン由来の建物・機器を付与して発行する",
        "点リストを共有しない MQTT / Hono 機器のみ raw.* を経由する",
        "検証済みテレメトリーは経路を問わず一本の subject に集約される"
      ]
    },
    {
      "dot": "cyan",
      "title": "蓄積",
      "items": [
        "建物 × 時刻でまとめて MinIO に書き、part 名で再送を冪等にする",
        "CompactionWorker が確定時刻の part を統合し、ILM が保持期間を切る",
        "最新値は発行と同時に KV に入り、直近値の参照は Parquet を走査しない"
      ]
    },
    {
      "dot": "orange",
      "title": "図に含めない経路",
      "items": [
        "制御は逆向き — API → NATS → GatewayBridge → ゲートウェイ",
        "利用者・権限・制御監査は PostgreSQL 16 に永続化される",
        "資源エクスプローラは同じツインを API 経由で読む"
      ]
    }
  ]
}